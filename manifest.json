{
  "manifest_version": 3,
  "name": "Little Metronome",
  "version": "1.2.0",
  "description": "A small, keyboard-friendly metronome. Local audio, no dependencies.",
  "minimum_chrome_version": "124",
  "permissions": ["storage"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Little Metronome settings", "default_popup": "settings.html"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}
}
